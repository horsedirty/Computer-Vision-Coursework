        <mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size:18px;&quot;&gt;视频稳像算法流程 — 基于 SIFT + 维纳滤波&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontColor=#333333;strokeColor=none;fillColor=none;" parent="1" vertex="1">
